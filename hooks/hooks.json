{
  "description": "Novel Weaver 只读状态提醒；不调用模型、不联网、不替作者采纳正文。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_runner.py\" SessionStart",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/hook_runner.py\" SessionStart",
            "timeout": 10,
            "statusMessage": "读取小说项目状态",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_runner.py\" UserPromptSubmit",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/hook_runner.py\" UserPromptSubmit",
            "timeout": 10,
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/hook_runner.py\" Stop",
            "commandWindows": "python \"${PLUGIN_ROOT}/scripts/hook_runner.py\" Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
