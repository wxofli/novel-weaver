{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "novel_weaver": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${PLUGIN_ROOT}", "--locked", "novelctl", "mcp", "serve"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
